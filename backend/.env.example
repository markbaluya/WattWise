# WattWise backend environment template.
# Copy to `.env` and fill in real values. Never commit `.env`.

# Required: Google Gemini API key (server-side only).
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: port the API listens on.
PORT=3000

# Optional: comma-separated list of allowed browser origins for CORS.
# Leave blank to allow all origins (fine for native mobile clients).
ALLOWED_ORIGINS=

# Optional: max auth/chat requests per IP per minute.
RATE_LIMIT_MAX=30

# NOTE: The administrator password is NOT stored here.
# On first launch the app asks you to create the admin password; only a bcrypt
# hash is saved in backend/.data/admin.json (git-ignored).